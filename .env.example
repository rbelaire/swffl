# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API.

# Safe to expose to the browser (used for public reads + admin auth).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the site name shown in a few places. Defaults to "So Whopped FFL".
NEXT_PUBLIC_SITE_NAME=So Whopped FFL
